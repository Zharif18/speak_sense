# --- Core ---
DATABASE_URL=postgresql://speaksense:speaksense@localhost:5432/speaksense
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
# Comma-separated. Add your deployed frontend URL here in production.
ALLOWED_ORIGINS=http://localhost:3000

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key
# Used only if you switch the speech pipeline to local Whisper instead of Gemini
WHISPER_MODEL=base

# --- Storage (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=speaksense-sessions

# --- Sponsor integrations ---
WOLFRAM_APP_ID=your-wolfram-alpha-app-id
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/speaksense

# --- Semantic search & similarity-aware coaching (Actian VectorAI DB) ---
# Run the DB locally first: `docker compose up -d vectorai` (see docker-compose.yml)
# then confirm it's up: curl http://localhost:6573/
# The Python client talks to the GRPC port (6574), not the REST port (6573).
# Auth is off by default on a fresh local container -- no key needed for local dev.
ACTIAN_VECTORAI_URL=localhost:6574
ACTIAN_VECTORAI_COLLECTION=speaksense_sessions

# Local embedding model (sentence-transformers) -- VectorAI DB doesn't ship
# its own embedding model, this generates the vectors it stores. Downloads
# once (~90MB) on first use, then runs fully offline/locally after that.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Wearables ---
NOISEFIT_API_BASE=https://api.noise.com
HEALTH_CONNECT_ENABLED=true

PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python